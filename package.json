{
  "name": "@vantageos/vantage-postforme",
  "version": "0.1.0",
  "description": "Multi-platform social posting MCP server for VantageOS orchestrators. Wraps the official Post For Me TypeScript SDK with first-class, named MCP tools.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "vantage-postforme-mcp": "dist/server.js"
  },
  "files": [
